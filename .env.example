# --- Proveedor de Linkmi -----------------------------------------------------
# "s3" o "r2". Es el interruptor del corte: cambiarlo y reiniciar es todo lo que
# hace falta para migrar o revertir. Por defecto "s3" para que desplegar el
# codigo no cambie nada por si solo.
# NO afecta a SICOM: ese bucket se queda en Amazon pase lo que pase.
STORAGE_PROVIDER=s3

# --- Credenciales AWS S3 -----------------------------------------------------
# Necesarias siempre: con STORAGE_PROVIDER=s3 las usa Linkmi, y en cualquier
# caso las usa SICOM. boto3 tambien las toma de ~/.aws o del rol IAM.
AWS_ACCESS_KEY_ID=tu_access_key_aqui
AWS_SECRET_ACCESS_KEY=tu_secret_key_aqui
AWS_REGION=us-east-1

# --- Credenciales Cloudflare R2 (usadas si STORAGE_PROVIDER=r2) --------------
# El Account ID esta en el dashboard de Cloudflare (R2 > Overview).
R2_ACCOUNT_ID=tu_account_id_aqui
R2_ACCESS_KEY_ID=tu_r2_access_key_aqui
R2_SECRET_ACCESS_KEY=tu_r2_secret_key_aqui

# --- Buckets de Linkmi -------------------------------------------------------
# Cada proveedor tiene los suyos, porque los nombres no tienen por que coincidir
# (en R2 los tres pueden consolidarse en uno solo). Si una variable R2_* se deja
# vacia, se usa la S3_* equivalente.
S3_BUCKET_NAME=mi-bucket-principal
S3_BUCKET_SECONDARY_NAME=mi-bucket-secundario
S3_DOWNLOAD_BUCKET_NAME=mi-bucket-descargas

R2_BUCKET_NAME=
R2_BUCKET_SECONDARY_NAME=
R2_DOWNLOAD_BUCKET_NAME=

# --- Bucket de SICOM ---------------------------------------------------------
# Fuera de la migracion: siempre Amazon, con independencia de STORAGE_PROVIDER.
S3_SICOM_BUCKET_NAME=sicomimages

# --- Firmado -----------------------------------------------------------------
# Expiracion de las URLs firmadas, en segundos. R2 admite 604800 (7 dias) como maximo.
PRESIGNED_URL_EXPIRATION=3600
